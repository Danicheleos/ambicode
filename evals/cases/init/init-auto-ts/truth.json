      "quote": "Import another context only through its `index.ts`",
      "location": "scratch/page-7.md:5"
    },
    {
      "id": "event-names",
      "basis": "written",
      "quote": "Event names are `<context>.<past-tense-verb>`",
      "location": "scratch/page-7.md:9"
    },
