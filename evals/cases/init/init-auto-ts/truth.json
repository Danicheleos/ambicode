{
  "stack": "TypeScript service by bounded context with a shared kernel, jest and eslint declared in package.json",
  "projects": [
    {
      "id": "lendbox",
      "root": ".",
      "paths": [
        "src/"
      ],
      "languages": [
        "typescript"
      ],
      "packs": [
        "builtin/common-design",
        "builtin/common-code",
        "builtin/common-errors",
        "builtin/common-security",
        "builtin/common-verification",
        "builtin/common-checks"
      ],
      "checks": {
        "test": {
          "all": "npm test",
          "file": "npx jest --findRelatedTests {file}"
        },
        "lint": {
          "all": "npm run lint",
          "file": "npx eslint {file}"
        }
      }
    }
  ],
  "plausiblePacks": [
    "builtin/common-design",
    "builtin/common-code",
    "builtin/common-errors",
    "builtin/common-security",
    "builtin/common-verification",
    "builtin/common-checks"
  ],
  "packsThatDoNotFit": [
    "angular-",
    "express-",
    "python-quality"
  ],
  "conventions": [
    {
      "id": "context-index-imports",
