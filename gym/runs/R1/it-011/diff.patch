+        assert.doesNotMatch(output.result.statusReason ?? '', AT_MOST_ONE_CALL);
+        await nodeFileSystem.remove(output.snapshotDirectory);
+      } finally {
+        await context.dispose();
+      }
+    });
+  });
+
