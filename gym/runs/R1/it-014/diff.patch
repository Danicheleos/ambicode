@@ -218,19 +218,30 @@ export function buildSummary(cases) {
   return summary;
 }
 
-/** `cases` as for `buildSummary`; a field the envelope lacked stays null, and a failed run has no entry. */
+// Copied from src/cli/commands/review.ts: this .mjs cannot import the TypeScript constant.
+// A test pins equality, so a recording's flag and a live review's `partial` agree on "short".
+export const SHORT_REVIEWER_TURNS = 2;
+
+/**
+ * `cases` as for `buildSummary`; a field the envelope lacked stays null, and a failed run has no entry.
+ * `atMostOneToolCall` is null, never false, when the turn count is unknown.
+ */
 export function buildUsage(cases) {
   return {
     schemaVersion: 1,
     cases: cases.map(({ case: name, runs }) => ({
       case: name,
-      runs: succeeded(runs).map(({ run, usage }) => ({
-        run,
-        turns: usage?.turns ?? null,
-        apiDurationMs: usage?.apiDurationMs ?? null,
-        outputTokens: usage?.outputTokens ?? null,
-        costUsd: usage?.costUsd ?? null,
-      })),
+      runs: succeeded(runs).map(({ run, usage }) => {
+        const turns = usage?.turns ?? null;
+        return {
+          run,
+          turns,
+          apiDurationMs: usage?.apiDurationMs ?? null,
+          outputTokens: usage?.outputTokens ?? null,
+          costUsd: usage?.costUsd ?? null,
+          atMostOneToolCall: turns === null ? null : turns <= SHORT_REVIEWER_TURNS,
+        };
+      }),
     })),
   };
 }
