{
  "name": "ambicode",
  "version": "0.2.7",
  "private": true,
  "description": "AMBICODE Claude Code plugin helpers: scoped policy, evidence checks, independent review, human-selected publication.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test --test-reporter=spec \"src/**/*.test.ts\" \"*.test.mjs\"",
    "validate:plugin": "node package-candidate.mjs --validate-plugin",
    "fixtures": "node fixtures/materialize.mjs",
    "evals": "claude plugin eval . --runs 3 --ablation with-without --scaffold --allow-tools Bash --no-publish",
    "package:candidate": "node package-candidate.mjs",
    "package:reproducible": "node package-candidate.mjs --check-reproducible",
    "smoke:candidate": "node smoke-candidate.mjs",
    "smoke:install-local": "node install-local.smoke.mjs",
    "verify": "npm run build && npm run typecheck && npm run test:unit && npm run validate:plugin"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/view": "^11.1.1",
    "eta": "^3.5.0",
    "execa": "^10.0.1",
    "fastify": "^5.12.5",
    "isbinaryfile": "^6.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "typescript": "^5.9.3"
  }
}
