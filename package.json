{
  "name": "ambicode",
  "version": "0.5.1",
  "private": true,
  "description": "AMBICODE Claude Code plugin helpers: scoped policy, evidence checks, independent review, human-selected publication.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "imports": {
    "#cli/*": "./src/cli/*.ts",
    "#composition/*": "./src/composition/*.ts",
    "#harness/*": "./src/harness/*.ts",
    "#hook/*": "./src/hook/*.ts",
    "#modules/*": "./src/modules/*.ts",
    "#platform/*": "./src/platform/*.ts",
    "#skills/*": "./src/skills/*.ts",
    "#testing/*": "./src/testing/*.ts",
    "#types/*": "./src/types/*.ts",
    "#util/*": "./src/util/*.ts"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test --test-reporter=spec \"src/**/*.test.ts\" \"tools/*.test.mjs\" \"fixtures/*.test.mjs\" \"evals/scripts/*.test.mjs\"",
    "validate:plugin": "node tools/package-candidate.mjs --validate-plugin",
    "fixtures": "node fixtures/materialize.mjs",
    "evals": "node evals/scripts/run.mjs",
    "evals:dry": "node evals/scripts/run.mjs --dry-run",
    "evals:track": "node evals/scripts/track.mjs",
    "version": "node tools/sync-plugin-version.mjs",
    "bump": "npm version patch --no-git-tag-version",
    "package:candidate": "node tools/package-candidate.mjs",
    "package:reproducible": "node tools/package-candidate.mjs --check-reproducible",
    "smoke:candidate": "node tools/smoke-candidate.mjs",
    "smoke:install-local": "node tools/install-local.smoke.mjs",
    "verify": "npm run build && npm run typecheck && npm run test:unit && npm run validate:plugin"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
