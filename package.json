{
  "name": "ambicode",
  "version": "0.1.0",
  "private": true,
  "description": "AMBICODE Claude Code plugin helpers: scoped policy, evidence checks, independent review, human-selected publication.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test --test-reporter=spec \"src/**/*.test.ts\"",
    "validate:plugin": "claude plugin validate . --strict",
    "fixtures": "node fixtures/materialize.mjs",
    "evals": "claude plugin eval . --runs 3 --ablation with-without --scaffold --no-publish",
    "verify": "npm run typecheck && npm run test:unit && npm run build && npm run validate:plugin"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
